# Copy to .env and fill in. Never commit .env.

# MongoDB: a local server or an Atlas cluster. On Atlas, paste the connection string
# from Atlas -> Connect -> Drivers. The harness keeps its own database; the questions
# are asked against the sample_mflix database.
MONGODB_URI=mongodb://localhost:27017
MH_DB=harness
MH_MFLIX_DB=sample_mflix

# Vector search: 1 uses Atlas Vector Search when the deployment supports it and
# falls back to in-process cosine similarity otherwise. 0 always uses the fallback.
MH_USE_VECTOR=1

# The model that answers questions and proposes harness edits. Any OpenRouter model
# id works; a weaker model makes the search noisier, which is itself interesting.
OPENROUTER_API_KEY=
OPENROUTER_KEY_FILE=
MH_MODEL=z-ai/glm-5.3-flash
MH_TEMPERATURE=0.1
MH_PROPOSAL_TEMPERATURE=0.7

# Parallel model calls: the suite is 57 questions, so this decides how long a
# generation takes.
MH_WORKERS=8

# Local embedding model for the memory of past failures (no API key needed).
MH_EMBED_MODEL=BAAI/bge-small-en-v1.5
MH_REPLAY_THRESHOLD=0.93

# Safety rails for generated queries.
MH_MAX_ROWS=500
MH_MAX_TIME_MS=20000

# Where the cached reference answers are kept.
MH_CACHE_DIR=.cache
